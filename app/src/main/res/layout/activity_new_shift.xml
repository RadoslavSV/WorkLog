<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="34dp"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New Shift"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="24dp" />

        <!-- SHIFT DATE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shift Date"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnShiftDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date" />

        <!-- SHIFT START -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shift Start"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etStartHour"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:hint="HH"
                android:inputType="number"
                android:maxLength="2"
                android:padding="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="20sp"
                android:padding="8dp" />

            <EditText
                android:id="@+id/etStartMinute"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:hint="MM"
                android:inputType="number"
                android:maxLength="2"
                android:padding="12dp" />

        </LinearLayout>

        <!-- SHIFT END -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shift End"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etEndHour"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:hint="HH"
                android:inputType="number"
                android:maxLength="2"
                android:padding="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="20sp"
                android:padding="8dp" />

            <EditText
                android:id="@+id/etEndMinute"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:hint="MM"
                android:inputType="number"
                android:maxLength="2"
                android:padding="12dp" />

        </LinearLayout>

        <!-- BREAK -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Break (minutes)"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etBreak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3"
            android:padding="12dp" />

        <!-- TOTAL -->

        <TextView
            android:id="@+id/tvShiftTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: 0h 0m"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <!-- SAVE -->

        <Button
            android:id="@+id/btnSaveShift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Shift"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>